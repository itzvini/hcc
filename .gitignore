node_modules/
# Never commit secrets — ignore every .env variant
.env
.env.*
*.env
.DS_Store
.railway/
.claude/
.tmp/
docs/
.discord-context/

# Local-only dev auth bypass — never commit/deploy the active file.
# The committed lib/dev-login.example.js is the inert template; copy it to enable.
lib/dev-login.js

# Highrise Design System assets (local reference only)
Highrise Design System/

# Temp and debug files
*.tmp
*.log
C*Temp*.json
Temp*.json
debug-*.json
test-*.json

# Python bytecode
__pycache__/
*.pyc

# Build tooling, local only. The site runs on the generated output alone
# (collections.json + img/collections/), so none of this needs to ship — and
# tools/item-ids.json is a bulk map of Highrise's internal catalogue ids.
tools/
*.py
